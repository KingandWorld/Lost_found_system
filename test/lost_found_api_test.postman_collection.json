            "header": [
              { "key": "token", "value": "{{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/username/admin",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "username", "admin"]
            },
            "description": "根据用户名查询用户信息"
          }
        },
        {
          "name": "发送密码重置验证码",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/sendCode?email=zhangsan@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "sendCode"],
              "query": [
                { "key": "email", "value": "zhangsan@example.com" }
              ]
            },
            "description": "发送密码重置验证码到用户邮箱"
          }
        },
        {
          "name": "注册新用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.code === '200') {",
                  "    console.log('用户注册成功');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"test_api_user_{{timestamp}}\",\n    \"password\": \"123456\",\n    \"name\": \"测试用户\",\n    \"phone\": \"13800138002\",\n    \"email\": \"test_{{timestamp}}@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/add",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "add"]
            },
            "description": "注册新用户账号"
          }
        },
        {
          "name": "更新用户信息",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "token", "value": "{{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"更新后的管理员名称\",\n    \"phone\": \"13900139099\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/1",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "1"]
            },
            "description": "更新指定用户的信息"
          }
        }
      ],
      "description": "用户注册、登录、查询、更新等操作"
    },
    {
